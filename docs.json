{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "DexBuilder Developer Docs",
  "description": "Build perpetual trading applications and branded DEXs on DexBuilder.",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "https://www.dexbuilder.com/"
  },
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#00A833",
    "light": "#16D96A",
    "dark": "#007A29"
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": ["curl", "javascript", "python"]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "DexBuilder",
        "href": "https://www.dexbuilder.com/"
      },
      {
        "label": "Trading Demo",
        "href": "https://demo.dexbuilder.com/en/perps"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Builder",
      "href": "https://www.dexbuilder.com/en/builder"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt"]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started/choose-a-path",
              "getting-started/trader-quickstart",
              "getting-started/builder-quickstart",
              "getting-started/integration-checklist"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/platform-overview",
              "concepts/accounts-and-tenancy",
              "concepts/order-lifecycle",
              "concepts/settlement-model",
              "concepts/fee-model"
            ]
          },
          {
            "group": "Accounts and security",
            "pages": [
              "authentication/overview",
              "authentication/request-signing",
              "authentication/permissions",
              "authentication/idempotency"
            ]
          },
          {
            "group": "Trading integration",
            "pages": [
              "trading/market-data",
              "trading/place-first-order",
              "trading/positions-and-margin",
              "trading/websocket"
            ]
          },
          {
            "group": "Funds and settlement",
            "pages": [
              "funds/overview",
              "funds/deposits",
              "funds/withdrawals",
              "funds/pnl-settlement",
              "funds/transaction-builder",
              "funds/ledger-and-reconciliation"
            ]
          },
          {
            "group": "Build a DEX",
            "pages": [
              "builders/overview",
              "builders/project-setup",
              "builders/onboard-users",
              "builders/configure-fees",
