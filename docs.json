          },
          {
            "group": "Operations",
            "pages": [
              "operations/system-status",
              "operations/error-codes",
              "operations/rate-limits",
              "operations/go-live"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/environments",
              "resources/sdk-and-tools",
              "resources/changelog"
            ]
          }
        ]
      },
      {
        "tab": "Trading Reference",
        "openapi": "openapi/trading-v1.yaml"
      },
      {
        "tab": "Builder Reference",
        "openapi": "openapi/builder-preview.yaml"
